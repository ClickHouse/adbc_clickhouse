// part: metadata

[tags]
caveats = ["`DateTime64` keeps the column's time zone"]

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "format": "l",
            "flags": ["nullable"]
        },
        {
            "name": "value",
            "format": "tsu:UTC",
            "flags": ["nullable"]
        },
        {
            "name": "value2",
            "format": "tsu:Asia/Tokyo",
            "flags": ["nullable"]
        }
    ]
}
