// part: metadata

sort-keys = [["res", "ascending"]]

[tags]
caveats = ["ClickHouse attaches the server time zone to `DateTime64` values without one"]

// part: bind_query

SELECT {res:Nullable(DateTime64(3))} AS res

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "tsm:UTC",
            "flags": ["nullable"]
        }
    ]
}
